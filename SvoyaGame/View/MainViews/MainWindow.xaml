<Window x:Class="SvoyaGame.View.MainViews.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SvoyaGame"
        mc:Ignorable="d"
        Title="Своя игра — Панель администратора"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#0B1E3A">

    <Window.Resources>
        <!-- ==================== ЦВЕТА НОВОГОДНЕЙ ТЕМЫ ==================== -->
        <SolidColorBrush x:Key="BgDeep"     Color="#0B1E3A"/>
        <!-- тёмно-синий фон -->
        <SolidColorBrush x:Key="BgPanel"    Color="#122B4E"/>
        <!-- панель -->
        <SolidColorBrush x:Key="BgPanel2"   Color="#1A3A66"/>
        <!-- панель светлее -->
        <SolidColorBrush x:Key="AccentGold" Color="#FFD166"/>
        <!-- золото -->
        <SolidColorBrush x:Key="AccentGreen" Color="#2ECC71"/>
        <!-- ёлочно-зелёный -->
        <SolidColorBrush x:Key="AccentRed"  Color="#E63946"/>
        <!-- красный -->
        <SolidColorBrush x:Key="TextMain"   Color="#F1FAFF"/>
        <SolidColorBrush x:Key="TextMuted"  Color="#9FB3C8"/>

        <!-- ==================== БАЗОВЫЙ СТИЛЬ КНОПОК ==================== -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0B1E3A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="#566573"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentGold}"/>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
        </Style>

        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ==================== СТИЛЬ ПОЛЕЙ ВВОДА ==================== -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1E3A"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="#2C4A75"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentGold}"/>
        </Style>

        <!-- ==================== СТИЛЬ DataGrid ==================== -->
        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{StaticResource BgPanel}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BgPanel2}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0B1E3A"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="#2C4A75"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F4E79"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
		<Style x:Key="DarkTabItem" TargetType="TabItem">
			<Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabItem">
						<Border x:Name="bd"
                        Background="#0B1E3A"
                        CornerRadius="8,8,0,0"
                        Padding="18,8"
                        Margin="0,0,4,0">
							<ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGold}"/>
								<Setter Property="Foreground" Value="#0B1E3A"/>
							</Trigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsMouseOver" Value="True"/>
									<Condition Property="IsSelected" Value="False"/>
								</MultiTrigger.Conditions>
								<Setter TargetName="bd" Property="Background" Value="#1A3A66"/>
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

    <!-- ==================== ОСНОВНАЯ СЕТКА ==================== -->
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================================== -->
        <!-- ЛЕВАЯ ПАНЕЛЬ АДМИНИСТРАТОРА                           -->
        <!-- ===================================================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BgPanel}"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- заголовок -->
                    <RowDefinition Height="Auto"/> <!-- создание комнаты -->
                    <RowDefinition Height="Auto"/> <!-- статус -->
                    <RowDefinition Height="Auto"/> <!-- ТОП-3 -->
                    <RowDefinition Height="Auto"/> <!-- подпись таблицы -->
                    <RowDefinition Height="*"/> <!-- таблица игроков -->
                    <RowDefinition Height="Auto"/> <!-- кнопка сброса -->
                    <RowDefinition Height="Auto"/> <!-- показать ответ / свернуть вопрос -->
					<RowDefinition Height="Auto"/> <!-- Полный сброс -->
				</Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0"
                           Text="🎄 ПАНЕЛЬ АДМИНИСТРАТОРА"
                           Foreground="{StaticResource AccentGold}"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"/>

                <!-- Создание комнаты -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRoomNumber"
                             Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Text="1234"
                             FontSize="16"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="34"/>
                    <Button x:Name="BtnCreateRoom"
                            Grid.Column="1"
                            Style="{StaticResource GoldButton}"
                            Content="Создать комнату"
                            Click="BtnCreateRoom_Click"
                            Height="34"
                            Margin="8,0,0,0"/>
                </Grid>

                <!-- Статус -->
                <TextBlock x:Name="StatusText"
                           Grid.Row="2"
                           Text="Статус: Не подключен"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <!-- ТОП-3 нажатий -->
                <Border Grid.Row="3"
                        Background="#0B1E3A"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🏆 ТОП-3 нажатий"
                                   Foreground="{StaticResource AccentGold}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="Top1Text" Text="1. —" Foreground="{StaticResource AccentGreen}"  FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="Top2Text" Text="2. —" Foreground="{StaticResource TextMain}"     FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Top3Text" Text="3. —" Foreground="{StaticResource TextMain}"     FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Подпись таблицы -->
                <TextBlock Grid.Row="4"
                           Text="👥 Игроки в комнате"
                           Foreground="{StaticResource AccentGold}"
                           FontWeight="Bold"
                           FontSize="13"
                           Margin="2,0,0,6"/>

                <!-- Таблица игроков -->
                <DataGrid x:Name="GridPlayers"
                          Grid.Row="5"
                          Style="{StaticResource DarkDataGrid}">
                    <DataGrid.Columns>
                        <!-- 1. Статус -->
                        <DataGridTemplateColumn Header="✔" Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="12" Height="12"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     ToolTip="{Binding StatusText}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#3C4A5E"/>
                                                <!-- оффлайн -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#2ECC71"/>
                                                        <!-- онлайн -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. Имя -->
                        <DataGridTextColumn Header="Имя"
                                            Binding="{Binding Name}"
                                            Width="*"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 3. Очки -->
                        <DataGridTextColumn Header="Очки"
                                            Binding="{Binding Score}"
                                            Width="60"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 4. Поле ввода -->
                        <DataGridTemplateColumn Header="Ввод" Width="66">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding BetInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}"
                                             Margin="4,6"
                                             TextAlignment="Center"
                                             FontSize="13"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. Минус -->
                        <DataGridTemplateColumn Header="−" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="−"
                                            Style="{StaticResource RedButton}"
                                            Click="BtnMinusScore_Click"
                                            Tag="{Binding}"
                                            Margin="4,6"
                                            Padding="0"
                                            FontSize="16"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 6. Плюс -->
                        <DataGridTemplateColumn Header="+" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+"
                                            Style="{StaticResource GreenButton}"
                                            Click="BtnPlusScore_Click"
                                            Tag="{Binding}"
                                            Margin="4,6"
                                            Padding="0"
                                            FontSize="16"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Кнопка сброса -->
                <Button x:Name="BtnReset"
                        Grid.Row="6"
                        Style="{StaticResource RedButton}"
                        Content="🔄 СБРОСИТЬ РАУНД"
                        Click="BtnReset_Click"
                        IsEnabled="False"
                        Height="38"
                        Margin="0,12,0,0"/>

                <!-- Показать ответ / Свернуть вопрос -->
                <Grid Grid.Row="7" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnShowAnswer"
                        Grid.Column="0"
                        Style="{StaticResource GreenButton}"
                        Content="👁 ПОКАЗАТЬ ОТВЕТ"
                        Click="BtnShowAnswer_Click"
                        IsEnabled="False"
                        Height="36"
                        Margin="0,0,4,0"
                        FontSize="12"/>

                    <Button x:Name="BtnHideQuestion"
                        Grid.Column="1"
                        Style="{StaticResource BlueButton}"
                        Content="✕ СВЕРНУТЬ ВОПРОС"
                        Click="BtnHideQuestion_Click"
                        IsEnabled="False"
                        Height="36"
                        Margin="4,0,0,0"
                        FontSize="12"/>
                </Grid>

				<Button x:Name="BtnResetAll"
                    Grid.Row="8"
                    Style="{StaticResource RedButton}"
                    Content="⚠ СБРОСИТЬ ВСЮ ИГРУ"
                    Click="BtnResetAll_Click"
                    Height="36"
                    Margin="0,8,0,0"
                    FontSize="13"/>
			</Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- ПРАВАЯ ПАНЕЛЬ — ИГРОВОЕ ПОЛЕ                           -->
        <!-- ===================================================== -->
		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<!-- игровое поле -->
				<RowDefinition Height="Auto"/>
				<!-- панель ответа для админа -->
				<RowDefinition Height="Auto"/>
				<!-- ответы финала -->
				<RowDefinition Height="Auto"/>
				<!-- кнопка "Открыть табло" -->
				<RowDefinition Height="Auto"/>
				<!-- Редактор вопросов -->
			</Grid.RowDefinitions>

			<!-- Игровое поле (было) -->
			<Border Grid.Row="0"
                Background="{StaticResource BgPanel}"
                CornerRadius="10"
                Padding="14">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
                       Text="❅ ИГРОВОЕ ПОЛЕ"
                       Foreground="{StaticResource AccentGold}"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

					<TabControl x:Name="RoundsTabControl"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource DarkTabItem}"
                        SelectionChanged="RoundsTabControl_SelectionChanged"/>
				</Grid>
			</Border>

			<!-- Панель «Карточка вопроса» для админа: вопрос слева, ответ справа -->
			<Border x:Name="AdminAnswerPanel"
        Grid.Row="1"
        Background="#0F2544"
        BorderBrush="{StaticResource AccentGold}"
        BorderThickness="2"
        CornerRadius="10"
        Padding="14"
        Margin="0,12,0,0"
        Visibility="Collapsed">
				<StackPanel>
					<TextBlock Text="🎯 КАРТОЧКА ВОПРОСА"
                   Foreground="{StaticResource AccentGold}"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>

					<TextBlock x:Name="AdminQuestionMeta"
                   Text=""
                   Foreground="#9FB3C8"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- ЛЕВАЯ КОЛОНКА: ВОПРОС -->
						<StackPanel Grid.Column="0" Margin="0,0,12,0">
							<TextBlock Text="ВОПРОС"
                           Foreground="{StaticResource AccentGold}"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

							<Image x:Name="AdminQuestionImage"
                       MaxHeight="110"
                       Margin="0,0,0,8"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>

							<TextBlock x:Name="AdminQuestionText"
                           Text=""
                           Foreground="{StaticResource TextMain}"
                           FontSize="16"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>

							<Button x:Name="AdminQuestionAudioBtn"
                        Style="{StaticResource GreenButton}"
                        Content="▶ ПРОСЛУШАТЬ ВОПРОС"
                        FontSize="12"
                        Padding="10,5"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Click="AdminQuestionAudio_Click"
                        Visibility="Collapsed"/>
						</StackPanel>

						<!-- РАЗДЕЛИТЕЛЬ -->
						<Rectangle Grid.Column="1"
                       Width="2"
                       Fill="#2C4A75"
                       Margin="0,4"/>

						<!-- ПРАВАЯ КОЛОНКА: ОТВЕТ -->
						<StackPanel Grid.Column="2" Margin="12,0,0,0">
							<TextBlock Text="ОТВЕТ"
                           Foreground="{StaticResource AccentGreen}"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

							<Image x:Name="AdminAnswerImage"
                       MaxHeight="110"
                       Margin="0,0,0,8"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>

							<TextBlock x:Name="AdminAnswerText"
                           Text=""
                           Foreground="{StaticResource AccentGreen}"
                           FontSize="16"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>

							<Button x:Name="AdminAnswerAudioBtn"
                        Style="{StaticResource GreenButton}"
                        Content="▶ ПРОСЛУШАТЬ ОТВЕТ"
                        FontSize="12"
                        Padding="10,5"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Click="AdminAnswerAudio_Click"
                        Visibility="Collapsed"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!-- Ответы финала -->
			<Border x:Name="FinalAnswersPanel"
        Grid.Row="2"
        Background="#0F2544"
        BorderBrush="{StaticResource AccentGreen}"
        BorderThickness="2"
        CornerRadius="10"
        Padding="14"
        Margin="0,12,0,0"
        MaxHeight="280"
        Visibility="Collapsed">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
                   Text="📩 СТАВКИ И ОТВЕТЫ"
                   Foreground="{StaticResource AccentGreen}"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

					<TextBlock x:Name="FinalAnswersEmpty"
                   Grid.Row="1"
                   Text="Ожидание ставок и ответов игроков..."
                   Foreground="#9FB3C8"
                   FontSize="13"
                   FontStyle="Italic"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>

					<ScrollViewer Grid.Row="1"
                      x:Name="FinalAnswersScroll"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
						<ItemsControl x:Name="FinalAnswersList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="#0B1E3A"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,3">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<StackPanel Grid.Column="0">
												<TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource AccentGold}"
                                               FontWeight="Bold"
                                               FontSize="14"/>
												<TextBlock Text="{Binding AnswerLabel}"
                                               Foreground="{StaticResource TextMain}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
											</StackPanel>

											<TextBlock Grid.Column="1"
                                           Text="{Binding BetLabel}"
                                           Foreground="{StaticResource AccentGreen}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
			<!-- Кнопка "Открыть табло" -->
			<Button x:Name="BtnOpenBoard"
                Grid.Row="3"
                Style="{StaticResource BlueButton}"
                Content="▶ ОТКРЫТЬ ТАБЛО ДЛЯ ЗАЛА"
                Click="BtnOpenBoard_Click"
                Height="44"
                Margin="0,12,0,0"
                FontSize="14"/>

			<Button x:Name="BtnEditThemes"
                Grid.Row="4"
                Style="{StaticResource GoldButton}"
                Content="✎ РЕДАКТОР ВОПРОСОВ"
                Click="BtnEditThemes_Click"
                Height="38"
                Margin="0,8,0,0"
                FontSize="13"/>
		</Grid>
	</Grid>
</Window>