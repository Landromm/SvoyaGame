<Window x:Class="SvoyaGame.View.MainViews.GameBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Табло для зала"
        Height="720" Width="1280"
        WindowStartupLocation="Manual"
        Background="#0B1E3A">

    <Window.Resources>
		<!-- ==================== ЦВЕТА НОВОГОДНЕЙ ТЕМЫ ==================== -->
		<SolidColorBrush x:Key="BgDeep"     Color="#0B1E3A"/>
		<!-- тёмно-синий фон -->
		<SolidColorBrush x:Key="BgPanel"    Color="#122B4E"/>
		<!-- панель -->
		<SolidColorBrush x:Key="BgPanel2"   Color="#1A3A66"/>
		<!-- панель светлее -->
		<SolidColorBrush x:Key="AccentGold" Color="#FFD166"/>
		<!-- золото -->
		<SolidColorBrush x:Key="AccentGreen" Color="#2ECC71"/>
		<!-- ёлочно-зелёный -->
		<SolidColorBrush x:Key="AccentRed"  Color="#E63946"/>
		<!-- красный -->
		<SolidColorBrush x:Key="TextMain"   Color="#F1FAFF"/>
		<SolidColorBrush x:Key="TextMuted"  Color="#9FB3C8"/>


		<!-- Стиль ячейки-плитки поля (только для отображения, не кликабельна) -->
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TileTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
		<!-- ==================== БАЗОВЫЙ СТИЛЬ КНОПОК ==================== -->
		<Style x:Key="BaseButton" TargetType="Button">
			<Setter Property="Foreground" Value="#0B1E3A"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="10,6"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Opacity" Value="0.85"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Opacity" Value="0.7"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="bd" Property="Background" Value="#2C3E50"/>
								<Setter Property="Foreground" Value="#566573"/>
								<Setter Property="Cursor" Value="Arrow"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
			<Setter Property="Background" Value="{StaticResource AccentGold}"/>
		</Style>

		<Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
			<Setter Property="Background" Value="{StaticResource AccentGreen}"/>
		</Style>

		<Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
			<Setter Property="Background" Value="{StaticResource AccentRed}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
			<Setter Property="Background" Value="#3498DB"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="300"/>
		</Grid.ColumnDefinitions>

		<!-- ========== ЛЕВАЯ ЧАСТЬ: сетка или вопрос ========== -->
		<Grid Grid.Column="0">

			<!-- =============== РЕЖИМ 1: ИГРОВОЕ ПОЛЕ =============== -->
			<Grid x:Name="GridView">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0"
				   Text="🎄 СВОЯ ИГРА 🎄"
				   Foreground="{StaticResource AccentGold}"
				   FontSize="34"
				   FontWeight="Bold"
				   HorizontalAlignment="Center"
				   Margin="0,18,0,10"/>

				<!-- Сюда динамически подставляется UniformGrid (раунд) или WrapPanel (финал) -->
				<Grid x:Name="BoardHost"
				  Grid.Row="1"
				  Margin="14"/>

				<TextBlock Grid.Row="2"
					Text="Выберите тему и стоимость"
					Foreground="#9FB3C8"
					FontSize="18"
					HorizontalAlignment="Center"
					Margin="0,0,0,18"/>
			</Grid>

			<!-- =============== РЕЖИМ 2: ПОКАЗ ВОПРОСА =============== -->
			<Grid x:Name="QuestionView" Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,24,0,10">
					<TextBlock x:Name="HeaderTheme"
               Text="Тема"
               Foreground="{StaticResource AccentGold}"
               FontSize="28"
               FontWeight="Bold"/>
					<TextBlock x:Name="HeaderSeparator"
               Text=" • "
               Foreground="{StaticResource AccentGold}"
               FontSize="28"
               FontWeight="Bold"/>
					<TextBlock x:Name="HeaderPrice"
               Text="100"
               Foreground="{StaticResource AccentGreen}"
               FontSize="28"
               FontWeight="Bold"/>
				</StackPanel>

				<Border Grid.Row="1"
                    Background="{StaticResource BgPanel}"
                    CornerRadius="16"
                    Margin="40,10,40,10"
                    Padding="30">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
							<Image x:Name="ImgQuestion"
                               MaxHeight="360"
                               Margin="0,0,0,12"
                               Stretch="Uniform"
                               Visibility="Collapsed"/>

							<TextBlock x:Name="QuestionText"
                                   Text=""
                                   Foreground="{StaticResource TextMain}"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
						</StackPanel>

						<Button x:Name="AudioBtnQuestion"
                            Grid.Row="1"
                            Style="{StaticResource GreenButton}"
                            Content="▶ ПРОСЛУШАТЬ"
                            FontSize="16"
                            Padding="16,8"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Click="AudioButton_Click"
                            Visibility="Collapsed"/>
					</Grid>
				</Border>

				<Border x:Name="AnswerPanel"
                    Grid.Row="2"
                    Background="#0F2544"
                    CornerRadius="10"
                    Margin="40,0,40,24"
                    Padding="18"
                    Visibility="Collapsed">
					<StackPanel>
						<TextBlock Text="ОТВЕТ:"
                               Foreground="#9FB3C8"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

						<Image x:Name="ImgAnswer"
                           MaxHeight="180"
                           Margin="0,8,0,0"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>

						<TextBlock x:Name="AnswerText"
                               Text=""
                               Foreground="{StaticResource AccentGreen}"
                               FontSize="24"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>

						<Button x:Name="AudioBtnAnswer"
                            Style="{StaticResource GreenButton}"
                            Content="▶ ПРОСЛУШАТЬ"
                            FontSize="14"
                            Padding="12,6"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Click="AudioButton_Click"
                            Visibility="Collapsed"/>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>

		<!-- ========== ПРАВАЯ ЧАСТЬ: табло очков ========== -->
		<Border Grid.Column="1"
            Background="#0F2544"
            BorderBrush="{StaticResource AccentGold}"
            BorderThickness="2,0,0,0"
            Padding="16,20">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0"
                       Text="🏆 ТАБЛО ОЧКОВ"
                       Foreground="{StaticResource AccentGold}"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

				<TextBlock x:Name="NoPlayersText"
                       Grid.Row="1"
                       Text="Ожидание игроков..."
                       Foreground="#9FB3C8"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

				<ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed"
                          x:Name="PlayersScroll">
					<ItemsControl x:Name="PlayersList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#0B1E3A"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,4">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<TextBlock Grid.Column="0"
                                               Text="{Binding RankLabel}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               MinWidth="30"
                                               Margin="0,0,8,0">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsOnline}" Value="False">
															<Setter Property="Foreground" Value="#7F8C8D"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>

										<TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Foreground" Value="{StaticResource TextMain}"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsOnline}" Value="False">
															<Setter Property="Foreground" Value="#7F8C8D"/>
															<Setter Property="FontStyle" Value="Italic"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>

										<TextBlock Grid.Column="2"
                                               Text="{Binding Score}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsOnline}" Value="False">
															<Setter Property="Foreground" Value="#7F8C8D"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>
	</Grid>
</Window>