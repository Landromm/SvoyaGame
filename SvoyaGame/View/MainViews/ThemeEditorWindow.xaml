<Window x:Class="SvoyaGame.View.MainViews.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Редактор вопросов"
        Height="780" Width="1320"
        MinHeight="600" MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        Background="#0B1E3A">

	<Window.Resources>
		<SolidColorBrush x:Key="BgDeep"     Color="#0B1E3A"/>
		<SolidColorBrush x:Key="BgPanel"    Color="#122B4E"/>
		<SolidColorBrush x:Key="BgPanel2"   Color="#1A3A66"/>
		<SolidColorBrush x:Key="AccentGold" Color="#FFD166"/>
		<SolidColorBrush x:Key="AccentGreen" Color="#2ECC71"/>
		<SolidColorBrush x:Key="AccentRed"  Color="#E63946"/>
		<SolidColorBrush x:Key="TextMain"   Color="#F1FAFF"/>
		<SolidColorBrush x:Key="TextMuted"  Color="#9FB3C8"/>

		<Style x:Key="BaseButton" TargetType="Button">
			<Setter Property="Foreground" Value="#0B1E3A"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="10,6"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Opacity" Value="0.85"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Opacity" Value="0.7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GoldButton"  TargetType="Button" BasedOn="{StaticResource BaseButton}">
			<Setter Property="Background" Value="{StaticResource AccentGold}"/>
		</Style>
		<Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
			<Setter Property="Background" Value="{StaticResource AccentGreen}"/>
		</Style>
		<Style x:Key="RedButton"   TargetType="Button" BasedOn="{StaticResource BaseButton}">
			<Setter Property="Background" Value="{StaticResource AccentRed}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style x:Key="BlueButton"  TargetType="Button" BasedOn="{StaticResource BaseButton}">
			<Setter Property="Background" Value="#3498DB"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<Style x:Key="DarkTextBox" TargetType="TextBox">
			<Setter Property="Background" Value="#0B1E3A"/>
			<Setter Property="Foreground" Value="{StaticResource TextMain}"/>
			<Setter Property="BorderBrush" Value="#2C4A75"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="CaretBrush" Value="{StaticResource AccentGold}"/>
			<Setter Property="AcceptsReturn" Value="True"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		</Style>

		<Style x:Key="DarkListBox" TargetType="ListBox">
			<Setter Property="Background" Value="#0B1E3A"/>
			<Setter Property="Foreground" Value="{StaticResource TextMain}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="4"/>
			<Setter Property="ItemContainerStyle">
				<Setter.Value>
					<Style TargetType="ListBoxItem">
						<Setter Property="Padding" Value="10,7"/>
						<Setter Property="Margin" Value="0,1"/>
						<Setter Property="Foreground" Value="{StaticResource TextMain}"/>
						<Setter Property="Cursor" Value="Hand"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
										<ContentPresenter/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="bd" Property="Background" Value="#1A3A66"/>
										</Trigger>
										<Trigger Property="IsSelected" Value="True">
											<Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGreen}"/>
											<Setter Property="Foreground" Value="#0B1E3A"/>
											<Setter Property="FontWeight" Value="Bold"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220"/>
			<ColumnDefinition Width="240"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ============ РАУНДЫ ============ -->
		<Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource BgPanel}"
                CornerRadius="10" Padding="12">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0" Text="🎬 РАУНДЫ"
                           Foreground="{StaticResource AccentGold}"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

				<ListBox x:Name="RoundsList"
                         Grid.Row="1"
                         Style="{StaticResource DarkListBox}"
                         DisplayMemberPath="Name"
                         SelectionChanged="RoundsList_SelectionChanged"/>

				<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
					<Button x:Name="BtnAddRound" Style="{StaticResource GreenButton}"
                            Content="+ Раунд" Click="BtnAddRound_Click" Width="100"/>
					<Button x:Name="BtnRemoveRound" Style="{StaticResource RedButton}"
                            Content="−" Click="BtnRemoveRound_Click" Width="60" Margin="6,0,0,0"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ============ ТЕМЫ ============ -->
		<Border Grid.Row="0" Grid.Column="1"
                Background="{StaticResource BgPanel}"
                CornerRadius="10" Padding="12" Margin="10,0,0,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0" Text="📚 ТЕМЫ"
                           Foreground="{StaticResource AccentGold}"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

				<ListBox x:Name="ThemesList"
                         Grid.Row="1"
                         Style="{StaticResource DarkListBox}"
                         DisplayMemberPath="Name"
                         SelectionChanged="ThemesList_SelectionChanged"/>

				<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
					<Button x:Name="BtnAddTheme" Style="{StaticResource GreenButton}"
                            Content="+ Тема" Click="BtnAddTheme_Click" Width="100"/>
					<Button x:Name="BtnRemoveTheme" Style="{StaticResource RedButton}"
                            Content="−" Click="BtnRemoveTheme_Click" Width="60" Margin="6,0,0,0"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ============ ПРАВАЯ ПАНЕЛЬ: РАУНД + ТЕМА + ВОПРОСЫ ============ -->
		<Border Grid.Row="0" Grid.Column="2"
                Background="{StaticResource BgPanel}"
                CornerRadius="10" Padding="14" Margin="10,0,0,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Заголовок раунда -->
				<Border Grid.Row="0"
                        Background="#0B1E3A"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10">
					<StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,6">
							<TextBlock Text="Раунд:"
                                       Foreground="{StaticResource AccentGold}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Width="70"/>
							<TextBox x:Name="TxtRoundName"
                                     Style="{StaticResource DarkTextBox}"
                                     FontSize="14"
                                     Height="30"
                                     Width="300"
                                     AcceptsReturn="False"
                                     TextWrapping="NoWrap"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtRoundName_TextChanged"/>
						</StackPanel>

						<StackPanel Orientation="Horizontal">
							<TextBlock Text="Цены:"
                                       Foreground="{StaticResource AccentGold}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Width="70"/>
							<TextBox x:Name="TxtPrices"
                                     Style="{StaticResource DarkTextBox}"
                                     FontSize="14"
                                     Height="30"
                                     Width="460"
                                     AcceptsReturn="False"
                                     TextWrapping="NoWrap"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Перечислите цены через запятую: 100, 200, 400, 700, 1000"
                                     TextChanged="TxtPrices_TextChanged"
                                     LostFocus="TxtPrices_LostFocus"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Заголовок темы -->
				<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Text="Тема:"
                               Foreground="{StaticResource AccentGold}"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Width="70"/>
					<TextBox x:Name="TxtThemeName"
                             Style="{StaticResource DarkTextBox}"
                             FontSize="14"
                             Height="30"
                             Width="460"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtThemeName_TextChanged"/>
				</StackPanel>

				<!-- Список вопросов -->
				<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
					<StackPanel x:Name="QuestionsPanel"/>
				</ScrollViewer>
			</Grid>
		</Border>

		<!-- ============ НИЖНЯЯ ПАНЕЛЬ ============ -->
		<Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" Orientation="Horizontal">
				<Button x:Name="BtnOpenMedia"
            Style="{StaticResource BlueButton}"
            Content="📁 MEDIA"
            Click="BtnOpenMedia_Click"
            Width="120"
            Height="40"
            FontSize="12"/>

				<Button x:Name="BtnExportPack"
            Style="{StaticResource GreenButton}"
            Content="📦 ВЫГРУЗИТЬ ПАК"
            Click="BtnExportPack_Click"
            Width="170"
            Height="40"
            Margin="8,0,0,0"
            FontSize="12"/>

				<Button x:Name="BtnImportPack"
            Style="{StaticResource GoldButton}"
            Content="📥 ЗАГРУЗИТЬ ПАК"
            Click="BtnImportPack_Click"
            Width="170"
            Height="40"
            Margin="8,0,0,0"
            FontSize="12"/>
			</StackPanel>

			<StackPanel Grid.Column="2" Orientation="Horizontal">
				<Button x:Name="BtnCancel" Style="{StaticResource BlueButton}"
                        Content="Отмена" Click="BtnCancel_Click"
                        Width="140" Height="40"/>
				<Button x:Name="BtnSave" Style="{StaticResource GoldButton}"
                        Content="💾 СОХРАНИТЬ" Click="BtnSave_Click"
                        Width="180" Height="40" Margin="10,0,0,0"/>
			</StackPanel>
		</Grid>
	</Grid>
</Window>